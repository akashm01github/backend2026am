<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Singn Up</title>
    <link rel="stylesheet" href="/signup.css">
</head>

<body>
    <div class="container">
        <h1>Sign Up</h1>
        <form action="/user" method="post" class="form">
            <input name="userName" type="text" placeholder="Enter the Name">
            <input name="email" type="text" placeholder="Enter the Email">
            <input name="password" type="text" placeholder="Enter the Password">
            <button>Submit</button>
        </form>
    </div>
</body>

</html>